<?xml version="1.0" encoding="utf-8"?>
<!-- Where the updater's APK may be shared from, so the system's installer
     gets a content: URI for it. Referenced by the FileProvider in
     AndroidManifest.xml. -->
<paths>
    <!-- getApplicationSupportDirectory()/updates (lib/main.dart). -->
    <files-path name="updates" path="updates/"/>
</paths>
